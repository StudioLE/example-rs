---
source: crates/example/src/app/cli_args.rs
expression: output
---
name example
bin example
version "x.y.z"
about "Exemplary template for Rust projects"
unknown_flags error
subcommand_required #true
flag --format help="Format to print output in." global=#true env=EXAMPLE_FORMAT {
    arg <FORMAT> {
        choices {
            choice human help="Human-readable text."
            choice json help=JSON.
            choice toml help=TOML.
            choice yaml help=YAML.
        }
    }
}
flag --log-level help="Set the log level." global=#true env=EXAMPLE_LOG_LEVEL {
    arg <LOG_LEVEL> {
        choices ignore_case=#true {
            choice error help="Errors only."
            choice warn help="Errors and warnings."
            choice info help="Errors, warnings, and info."
            choice debug help="Errors, warnings, info, and debug."
            choice trace help="Errors, warnings, info, debug, and trace."
        }
    }
}
flag --state-dir help="Directory to store status files in." global=#true env=EXAMPLE_STATE_DIR {
    arg <STATE_DIR>
}
flag "-h --help" help="Print help" action=help builtin=#true
flag "-V --version" help="Print version" action=version builtin=#true
complete state_dir type=dir
output human help="Human-readable text" default=#true
output json media_type="application/json" framing=json
output toml media_type="application/toml"
output yaml media_type="application/yaml"
select "--format"
cmd start help="Start the application." {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <ID> help="Identifier of the resource to start."
}
cmd status help="Print the application status." {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <ID> help="Identifier of the resource to query."
}
cmd stop help="Stop the application." {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <ID> help="Identifier of the resource to stop."
}
